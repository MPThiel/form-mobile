# Server runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — Railway injects DATABASE_URL automatically when you add a Postgres
# plugin to the project. Locally, point at a local Postgres or a free-tier
# Neon/Supabase database.
DATABASE_URL=

# Supabase Auth — JWT verification via JWKS (asymmetric keys, no shared secret).
# JWKS endpoint is derived from SUPABASE_PROJECT_URL as:
#   {SUPABASE_PROJECT_URL}/auth/v1/.well-known/jwks.json
# e.g. SUPABASE_PROJECT_URL=https://abcdefgh.supabase.co
SUPABASE_PROJECT_URL=
# Expected `aud` claim. Supabase issues "authenticated" for signed-in users.
SUPABASE_AUDIENCE=authenticated
# Expected `iss` claim. Leave blank to auto-derive as
# {SUPABASE_PROJECT_URL}/auth/v1; override only if your project differs.
SUPABASE_ISSUER=
# How long (seconds) to cache the fetched JWKS before re-fetching.
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600
# Service role key — the SECRET key from
# Supabase → Project Settings → API → service_role (secret). Used server-side
# only to send magic-link emails via the Supabase Auth API (POST /auth/magic-link).
# Never expose this to the client. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (server-side only — never ship to the client)
ANTHROPIC_API_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_TOKEN_ENCRYPTION_KEY=

# Cloudflare R2 — meal photo storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
