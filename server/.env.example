# Server runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — Railway injects DATABASE_URL automatically when you add a Postgres
# plugin to the project. Locally, point at a local Postgres or a free-tier
# Neon/Supabase database.
DATABASE_URL=

# Supabase Auth — JWT verification.
# JWKS endpoint is derived from SUPABASE_PROJECT_URL as:
#   {SUPABASE_PROJECT_URL}/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_URL=
SUPABASE_JWT_SECRET=

# Anthropic Claude (server-side only — never ship to the client)
ANTHROPIC_API_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_TOKEN_ENCRYPTION_KEY=

# Cloudflare R2 — meal photo storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
